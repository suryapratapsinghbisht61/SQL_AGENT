# Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Postgres admin (used only by docker-compose to initialise the DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
# Read-only role the app connects with
RO_USER=analyst_ro
RO_PASSWORD=change-me-readonly
DATABASE_URL=postgresql+psycopg2://analyst_ro:change-me-readonly@localhost:5432/chinook

MIN_SECONDS_BETWEEN_LLM_CALLS=6
MAX_ATTEMPTS=3
ROW_LIMIT=100
STATEMENT_TIMEOUT_SECONDS=10
